{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "title": "BlueBattery device found",
        "description": "{name} publishes on `{topic}`. Set it up? (Checking for current data can take up to a minute.)"
      },
      "user": {
        "title": "Search for BlueBattery devices",
        "description": "Enter the MQTT topic configured on the device (without the device ID). Factory default: `BlueBattery/BB-Display`.",
        "data": {
          "base_topic": "MQTT topic"
        }
      },
      "pick": {
        "title": "Several devices found",
        "data": {
          "node": "Device"
        }
      },
      "select": {
        "title": "Select devices",
        "description": "{name} provides {count} devices – all devices paired with the BB-Display. Select which ones to add – you can change this later via **Configure**. A device is missing? Pair it with the BB-Display first.\n\n{warning} Built-in Home Assistant discovery on the display active: {firmware_discovery}. If yes, entities will appear twice until it is switched off on the display.",
        "data": {
          "selected": "Devices"
        }
      }
    },
    "error": {
      "invalid_topic": "Invalid topic (no + or # allowed).",
      "no_fresh_data": "No current data is arriving from this device (only old stored messages). Is the display switched on and connected to MQTT? Try again in a minute.",
      "no_devices": "No new BlueBattery device found under this topic. Is the device publishing?"
    },
    "abort": {
      "not_bluebattery": "Not a BlueBattery device.",
      "already_configured": "This device is already set up."
    }
  },
  "options": {
    "abort": {
      "nothing_to_migrate": "No entities of the display's built-in Home Assistant discovery found – nothing to migrate.",
      "migration_done": "Migration finished: {renamed} entities took over their previous IDs (history continues). Still blocked: {blocked} (old entity still exists – is discovery on the display switched off?). Not found: {missing}."
    },
    "step": {
      "init": {
        "title": "BlueBattery",
        "menu_options": {
          "settings": "Devices and settings",
          "migrate_prepare": "Migration: prepare (take over IDs of the built-in discovery)",
          "migrate_apply": "Migration: finish"
        }
      },
      "migrate_prepare": {
        "title": "Prepare migration",
        "description": "{count} entities of the display's built-in Home Assistant discovery can be taken over. After finishing, the new entities use these IDs – dashboards, automations and history keep working:\n\n{list}\n\n**Next:** save, then switch off **Home Assistant** in the MQTT settings of the display, wait one minute and choose **Migration: finish**."
      },
      "migrate_apply": {
        "title": "Finish migration",
        "description": "{count} entities will take over their previous IDs. Old entities still present: {still_there} – if this is not 0, the built-in discovery on the display is probably still switched on.",
        "data": {
          "force_remove": "Remove remaining old entities (only if discovery is already off)"
        }
      },
      "settings": {
        "title": "BlueBattery options",
        "description": "New devices found: {new}\n\nOnly devices paired with the BB-Display are listed. Deselected devices are disabled (history is kept) unless removal is selected.",
        "data": {
          "selected": "Devices",
          "remove_deselected": "Remove deselected devices instead of disabling them",
          "timeout": "Seconds without data until unavailable",
          "truma_extended_modes": "Truma: offer VarioHeat/boost heating modes",
          "truma_combi_e": "Truma Combi E: energy source selectable"
        }
      }
    }
  },
  "issues": {
    "new_devices": {
      "title": "New BlueBattery device found",
      "description": "{title} provides new devices (newly paired with the BB-Display): {devices}.\n\nTo add them: **Settings → Devices & services → BlueBattery → Configure**."
    }
  },
  "exceptions": {
    "heater_fault": {
      "message": "The heater reports a fault and does not accept commands. Reset it on the heater's control panel."
    },
    "target_out_of_range": {
